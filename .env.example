# =============================================================================
# LLM 网关
# =============================================================================
# LLM 网关 baseUrl —— **必须是根 URL,不要带 /v1 / /v1beta / /anthropic 等协议后缀**。
# 本包会按 provider 自动拼正确后缀(openai-* → /v1,gemini → /v1beta,anthropic 无后缀,
# 由 Anthropic SDK 自己拼 /v1/messages)。
LLM_BASE_URL=https://ai-gateway.corp.internal
# LLM 网关的 API key
LLM_API_KEY=
# 默认 provider(合法值:havefun-openai / havefun-openai-responses / havefun-anthropic / havefun-gemini)
LLM_PROVIDER=havefun-anthropic
# 默认模型 id(必须在合并清单中,且 nativeApi 与 LLM_PROVIDER 对应协议一致)
LLM_MODEL=claude-opus-4-7
# (可选)额外模型清单 JSON 数组,用于在 builtin 之外注入网关支持的其他模型
LLM_EXTRA_MODELS_JSON=
# (可选)统一调节"思考预算",合法值 off / minimal / low / medium / high / xhigh。
# 不配则按 per-model 默认拉到该 model 实际上限(如 Opus 4.7 默认 xhigh → 经 thinkingLevelMap 拿到 anthropic max);
# 配置非法值会 fail-fast。仅 ops-bot 形态生效(code-reviewer 由 pi CLI 自己管 /thinking)。
LLM_REASONING_EFFORT=xhigh

# =============================================================================
# GitLab(code-reviewer 使用)
# =============================================================================
# GitLab 个人/项目 token,用于读 MR diff、发评论
GITLAB_TOKEN=
# GitLab 实例地址
GITLAB_HOST=https://gitlab.corp.internal
# CI 注入的变量(运行时由 GitLab 自动填充)
# CI_PROJECT_ID=
# CI_MERGE_REQUEST_IID=
# CI_COMMIT_SHA=

# =============================================================================
# 禅道(pi-tools-common 使用)
# =============================================================================
# 禅道实例地址
ZENTAO_BASE_URL=https://zentao.corp.internal
# 禅道 PAT 或 API token
ZENTAO_TOKEN=

# =============================================================================
# 钉钉(pi-tools-common 文档检索 + ops-bot 机器人 共用)
# =============================================================================
# 钉钉企业内部应用 AppKey / AppSecret(用于换 accessToken,调用文档 OpenAPI / 群机器人)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 钉钉机器人加签密钥(ops-bot 防伪用)
DINGTALK_BOT_SECRET=

# =============================================================================
# 阿里云 ARMS / SLS(ops-bot 使用)
# =============================================================================
ALICLOUD_AK=
ALICLOUD_SK=
# 默认 region
ALICLOUD_REGION=cn-hangzhou

# =============================================================================
# 会话存储
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# 观测 / 审计(@flower-ai/flower-telemetry)
# =============================================================================
# 审计上报地址(SIEM / 自定义 HTTP 接收端,留空则不上报;siemSink 为 critical,不受总开关影响)
SIEM_INGEST_URL=
# 观测总开关:设 0/false/off/no 关闭非 critical sink(JSONL / console);默认开
FLOWER_TELEMETRY=
# JSONL trace 输出路径(CI artifact 用;留空用默认 flower-review-trace.jsonl)
FLOWER_TELEMETRY_FILE=
# 全量观测事件实时推送端点(flower-observer ingest;留空不挂载 httpSink)
FLOWER_TELEMETRY_URL=
# httpSink 推送鉴权 Bearer token(可选,配合 FLOWER_TELEMETRY_URL 使用)
FLOWER_TELEMETRY_TOKEN=
# CI 日志打印开关:设 0/false/off/no 关闭 console 打印;默认开
FLOWER_VERBOSE=

# =============================================================================
# 观测服务(@flower-ai/flower-observer,常驻服务端)
# =============================================================================
# 监听端口(默认 4810)
OBSERVER_PORT=
# SQLite 文件路径(默认 data/observer.db;Docker 内为 /app/data/observer.db,挂 volume)
OBSERVER_DB_PATH=
# ingest/audit 写入端点 Bearer token(留空不鉴权;与客户端 FLOWER_TELEMETRY_TOKEN 配对)
OBSERVER_INGEST_TOKEN=
# 数据保留天数(默认 90;每日定时清理超期 trace 连同 events/security_events)
OBSERVER_RETENTION_DAYS=
# running 超时视为「半截」的展示阈值,分钟(默认 30)
OBSERVER_STALE_RUNNING_MINUTES=
# 内网 GitLab 根 URL(留空不渲染外链;用于列表/详情页拼 MR/commit/pipeline/diff 行锚点)
OBSERVER_GITLAB_BASE_URL=
# 设 1 打印 ingest 坏行诊断(默认静默)
DEBUG_OBSERVER=
