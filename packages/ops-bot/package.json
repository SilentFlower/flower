  },
  "bin": {
    "flower-ops-bot": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js 2>/dev/null || true",
