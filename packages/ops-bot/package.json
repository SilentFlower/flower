  "keywords": ["pi", "agent", "dingtalk", "ops", "sre", "arms", "aliyun", "chatbot", "llm"],
  "homepage": "https://github.com/SilentFlower/flower/tree/main/packages/ops-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentFlower/flower.git",
    "directory": "packages/ops-bot"
  },
  "bugs": {
    "url": "https://github.com/SilentFlower/flower/issues"
  },
  "license": "MIT",
  "author": "silentflower",
  "publishConfig": {
