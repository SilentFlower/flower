{
	"name": "@flower-ai/flower-providers",
	"version": "0.1.0",
	"type": "module",
	"description": "自定义 LLM provider 统一注册扩展,用于把内部 / 私有 LLM 网关接入 pi 系列 agent",
	"keywords": [
		"pi",
		"agent",
		"llm",
		"provider"
	],
	"homepage": "https://github.com/SilentFlower/flower/tree/main/packages/flower-providers#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SilentFlower/flower.git",
		"directory": "packages/flower-providers"
	},
	"bugs": {
		"url": "https://github.com/SilentFlower/flower/issues"
	},
	"license": "MIT",
	"author": "silentflower",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "tsc -p tsconfig.json --clean",
		"test": "vitest run"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.76.0",
		"@earendil-works/pi-coding-agent": "^0.76.0"
	},
	"devDependencies": {
		"vitest": "^3.2.4"
	}
}
